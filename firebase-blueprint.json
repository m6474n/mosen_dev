      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "read": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": ["message", "booking"]
        },
        "company": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "budget": {
          "type": "string"
        }
      },
      "required": ["id", "name", "email", "content", "read"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Administrative support posts"
    },
    "/case_studies/{caseStudyId}": {
      "schema": "CaseStudy",
      "description": "Premium case studies collection"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Workspace projects collection"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Client-facing service catalogue configurations"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Vault resources and scripts library"
    },
    "/blogs/{blogId}": {
      "schema": "Blog",
      "description": "Technical insights essays"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Ingested lead messages and booking info cards"
    }
  }
}
